{
  "name": "contract-review-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "合同审查 Agent 的 Vue 3 + Electron 本地桌面端",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "node scripts/launch-electron.cjs .",
    "dev:desktop": "concurrently -k \"npm:dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs .\"",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@streamparser/json": "^0.0.22",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-vue-next": "^0.468.0",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "electron": "^44.3.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
